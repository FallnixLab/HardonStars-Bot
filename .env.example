# Telegram
BOT_TOKEN=
DATABASE_PATH=data/hardon.sqlite3

# Set these prices before enabling orders. All RUB prices are in RUB.
PRICE_STAR_RUB=0
PRICE_PREMIUM_3M_RUB=0
PRICE_PREMIUM_6M_RUB=0
PRICE_PREMIUM_12M_RUB=0
PRICE_TON_RUB=0

# Native Telegram Stars checkout (XTR). Set separate amounts in Telegram Stars.
PRICE_STAR_XTR=0
PRICE_PREMIUM_3M_XTR=0
PRICE_PREMIUM_6M_XTR=0
PRICE_PREMIUM_12M_XTR=0
PRICE_TON_XTR=0

# Fragment Stars API SDK. Keep the wallet seed private; never commit .env.
FRAGMENT_ENABLED=false
FRAGMENT_API_BASE_URL=https://fragment-api.ydns.eu:8443
FRAGMENT_WALLET_SEED=

# Crypto Pay (CryptoBot)
CRYPTO_PAY_API_TOKEN=
CRYPTO_PAY_FIAT=RUB
# Empty means Crypto Pay accepts all supported cryptocurrencies.
CRYPTO_PAY_ACCEPTED_ASSETS=

# PayHot. Check the enabled methods/currencies in the merchant cabinet.
PAYHOT_API_KEY=
PAYHOT_CURRENCY=RUB
PAYHOT_CRYPTO_CURRENCY=RUB

# xRocket Pay API
XROCKET_API_TOKEN=
XROCKET_PRICE_CURRENCY=RUB
# Leave empty to let xRocket apply the invoice default. Multi-currency lists are not supported.
XROCKET_PAY_CURRENCIES=

# Content and links
SUPPORT_URL=
ADVERTISING_URL=
TERMS_URL=
PRIVACY_URL=
INSTRUCTIONS_URL=
RULES_URL=
PROJECTS_URL=https://project.hardon.cc/
